{
  "description": "Watch movies and dramas together with the group",
  "icon": {
    "emoji": "\ud83c\udfac"
  },
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "home.default",
      "name": "Home shows the hero carousel and rows",
      "path": "/",
      "expectSelector": "[data-testid=hero] [aria-roledescription=slide] ~ [aria-roledescription=slide]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**",
        "styles/**"
      ]
    },
    {
      "name": "Home shows the trending row",
      "path": "/",
      "expectSelector": "[data-testid=row-trending] [data-testid=series-card]"
    },
    {
      "name": "Home shows a genre row",
      "path": "/",
      "expectSelector": "[data-testid=row-genre] [data-testid=series-card]"
    },
    {
      "id": "series.browse",
      "name": "Discover lists every series",
      "path": "/#/discover",
      "expectSelector": "[data-testid=series-grid]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "discover.search",
      "name": "Discover search finds a series by title",
      "path": "/#/discover?q=robot",
      "expectText": "1 series",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Discover shows genre chips",
      "path": "/#/discover",
      "expectSelector": "[data-testid=genre-chips] [data-genre=comedy]"
    },
    {
      "id": "series.detail",
      "name": "Series detail lists episodes",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-state=locked]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "series.detail-page",
      "name": "Series detail page shows Watch now and related series",
      "path": "/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=related-series] [data-testid=series-tile]",
      "expectText": "Watch now",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "onboarding.genres",
      "name": "Genre onboarding offers genres to pick",
      "path": "/#/onboarding",
      "expectSelector": "[data-testid=genre-picker] button[aria-pressed]",
      "expectText": "What do you like to watch?",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Series detail offers follow and unlock",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-testid=unlock-button]"
    }
  ],
  "private_tables": [
    "profiles",
    "watch_history",
    "coin_transactions",
    "unlocked_episodes"
  ]
}
