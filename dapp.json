{
  "description": "Watch movies and dramas together with the group",
  "icon": {
    "emoji": "\ud83c\udfac"
  },
  "secrets": [
    {
      "key": "STRIPE_SECRET_KEY",
      "description": "Stripe secret key for the coin store (sk_live_... in production), from the Stripe Dashboard under Developers > API keys. Until it and STRIPE_WEBHOOK_SECRET are set, the coin store says payments are not set up yet.",
      "required": false,
      "private": true
    },
    {
      "key": "STRIPE_WEBHOOK_SECRET",
      "description": "Signing secret (whsec_...) of the Stripe webhook endpoint https://<this app's address>/api/stripe/webhook, subscribed to checkout.session.completed and checkout.session.async_payment_succeeded. Coins are credited only from events signed with it.",
      "required": false,
      "private": true
    },
    {
      "key": "AD_PROVIDER",
      "description": "Which rewarded-ad provider unlocks episodes. Only \"mock\" (a 5-second sample ad) exists today.",
      "required": false,
      "default": "mock"
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "series.browse",
      "name": "Series browse grid renders",
      "path": "/",
      "expectSelector": "[data-testid=series-grid]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "series.detail",
      "name": "Series detail lists episodes",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-state=locked]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "series.detail-page",
      "name": "Series detail page shows Watch now and related series",
      "path": "/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=related-series] [data-testid=series-tile]",
      "expectText": "Watch now",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "onboarding.genres",
      "name": "Genre onboarding offers genres to pick",
      "path": "/#/onboarding",
      "expectSelector": "[data-testid=genre-picker] button[aria-pressed]",
      "expectText": "What do you like to watch?",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Series detail offers follow and unlock",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-testid=unlock-button]"
    },
    {
      "id": "coins.store",
      "name": "Coins page shows the daily check-in and the coin store",
      "path": "/store",
      "expectSelector": "[data-testid=payments-not-configured]",
      "expectText": "Daily check-in",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Transaction history renders",
      "path": "/history",
      "expectText": "Transaction history"
    },
    {
      "name": "Browse shows the coin balance",
      "path": "/",
      "expectSelector": "[data-testid=coin-balance]"
    }
  ],
  "private_tables": [
    "profiles",
    "watch_history",
    "coin_transactions",
    "unlocked_episodes",
    "daily_check_ins",
    "ad_sessions",
    "coin_purchases",
    "stripe_events"
  ]
}
