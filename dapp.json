{
  "description": "Watch movies and dramas together with the group",
  "icon": {
    "emoji": "\ud83c\udfac"
  },
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "series.browse",
      "name": "Series browse grid renders",
      "path": "/",
      "expectSelector": "[data-testid=series-grid]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "series.detail",
      "name": "Series detail lists episodes",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-state=locked]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "series.detail-page",
      "name": "Series detail page shows Watch now and related series",
      "path": "/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=related-series] [data-testid=series-tile]",
      "expectText": "Watch now",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "onboarding.genres",
      "name": "Genre onboarding offers genres to pick",
      "path": "/#/onboarding",
      "expectSelector": "[data-testid=genre-picker] button[aria-pressed]",
      "expectText": "What do you like to watch?",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Series detail offers follow and unlock",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-testid=unlock-button]"
    }
  ],
  "private_tables": [
    "profiles",
    "watch_history",
    "coin_transactions",
    "unlocked_episodes"
  ]
}
