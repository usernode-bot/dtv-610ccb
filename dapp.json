{
  "description": "Watch movies and dramas together with the group",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "\ud83c\udfac"
  },
  "secrets": [
    {
      "key": "STRIPE_SECRET_KEY",
      "description": "Stripe secret key for the coin store (sk_live_... in production), from the Stripe Dashboard under Developers > API keys. Until it and STRIPE_WEBHOOK_SECRET are set, the coin store says payments are not set up yet.",
      "required": false,
      "private": true
    },
    {
      "key": "STRIPE_WEBHOOK_SECRET",
      "description": "Signing secret (whsec_...) of the Stripe webhook endpoint https://<this app's address>/api/stripe/webhook, subscribed to checkout.session.completed and checkout.session.async_payment_succeeded. Coins are credited only from events signed with it.",
      "required": false,
      "private": true
    },
    {
      "key": "AD_PROVIDER",
      "description": "Which rewarded-ad provider unlocks episodes. Only \"mock\" (a 5-second sample ad) exists today.",
      "required": false,
      "default": "mock"
    },
    {
      "key": "SENTRY_DSN",
      "description": "Sentry DSN for error monitoring (Sentry > Project settings > Client Keys (DSN)), like https://<key>@o0.ingest.sentry.io/<project>. Leave unset to turn error reporting off.",
      "required": false,
      "private": true,
      "staging_default": ""
    },
    {
      "key": "ADMIN_USERNAMES",
      "description": "Homeroom usernames allowed to add, edit, publish and delete series in Dtv's series manager (/admin), separated by commas, e.g. alice, bob. Leave empty and nobody can manage series.",
      "required": false,
      "private": false
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "home.default",
      "name": "Home shows the hero carousel and rows",
      "path": "/",
      "expectSelector": "[data-testid=hero] [aria-roledescription=slide] ~ [aria-roledescription=slide]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**",
        "styles/**"
      ]
    },
    {
      "name": "Home shows the trending row",
      "path": "/",
      "expectSelector": "[data-testid=row-trending] [data-testid=series-card]"
    },
    {
      "name": "Home shows a genre row",
      "path": "/",
      "expectSelector": "[data-testid=row-genre] [data-testid=series-card]"
    },
    {
      "id": "series.browse",
      "name": "Discover lists every series",
      "path": "/#/discover",
      "expectSelector": "[data-testid=series-grid]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "discover.search",
      "name": "Discover search finds a series by title",
      "path": "/#/discover?q=robot",
      "expectText": "1 series",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Discover shows genre chips",
      "path": "/#/discover",
      "expectSelector": "[data-testid=genre-chips] [data-genre=comedy]"
    },
    {
      "name": "App header shows the Dtv title",
      "path": "/",
      "expectSelector": "[data-testid=app-header]",
      "expectText": "Dtv"
    },
    {
      "id": "header.back",
      "name": "Series detail header has a back control",
      "path": "/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=app-header] [data-testid=header-back][href='/']",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "name": "My List header has a back control",
      "path": "/my-list",
      "expectSelector": "[data-testid=app-header] [data-testid=header-back]"
    },
    {
      "id": "series.detail",
      "name": "Series detail lists episodes",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-state=locked]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "series.detail-page",
      "name": "Series detail page shows Watch now and related series",
      "path": "/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=related-series] [data-testid=series-tile]",
      "expectText": "Watch now",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "onboarding.genres",
      "name": "Genre onboarding offers genres to pick",
      "path": "/#/onboarding",
      "expectSelector": "[data-testid=genre-picker] button[aria-pressed]",
      "expectText": "What do you like to watch?",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Series detail offers follow and unlock",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-testid=unlock-button]"
    },
    {
      "id": "coins.store",
      "name": "Coins page shows the daily check-in and the coin store",
      "path": "/store",
      "expectSelector": "[data-testid=payments-not-configured]",
      "expectText": "Daily check-in",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "mylist.following",
      "name": "My List opens on the Following tab",
      "path": "/my-list",
      "expectSelector": "[data-testid=my-list-tab-following][aria-current=page]",
      "expectText": "My List",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Transaction history renders",
      "path": "/history",
      "expectText": "Transaction history"
    },
    {
      "name": "Profile shows the coin balance",
      "path": "/profile",
      "expectSelector": "[data-testid=coin-balance]"
    },
    {
      "name": "My List watch history tab",
      "path": "/my-list/history",
      "expectSelector": "[data-testid=my-list-tab-history][aria-current=page]"
    },
    {
      "name": "Tab bar links to My list",
      "path": "/",
      "expectSelector": "nav [data-tab=my-list]"
    },
    {
      "id": "seo.series-meta",
      "name": "Series page has its own title, description and Open Graph tags",
      "path": "/series/bakery-on-maple-street",
      "expectSelector": "meta[property=\"og:title\"][content^=\"Bakery on Maple Street\"]",
      "expectText": "Watch now"
    },
    {
      "name": "Page links the web manifest",
      "path": "/",
      "expectSelector": "link[rel=manifest][href=\"/manifest.webmanifest\"]"
    },
    {
      "name": "Offline page renders",
      "path": "/offline.html",
      "expectText": "You are offline"
    },
    {
      "name": "robots.txt points at the sitemap",
      "path": "/robots.txt",
      "expectText": "sitemap.xml"
    },
    {
      "id": "browse.language",
      "name": "Profile offers English and Indonesian",
      "path": "/profile",
      "expectSelector": "[data-testid=language-select] option[value=id]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "admin.not-admin",
      "name": "Series manager refuses a non-admin",
      "path": "/admin",
      "expectSelector": "[data-testid=admin-required]",
      "expectText": "Only Dtv admins can manage series",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Skip link leads to the content",
      "path": "/my-list",
      "expectSelector": "a#skip-link[href=\"#app\"]"
    }
  ],
  "private_tables": [
    "profiles",
    "watch_history",
    "coin_transactions",
    "unlocked_episodes",
    "daily_check_ins",
    "ad_sessions",
    "coin_purchases",
    "stripe_events",
    "analytics_events"
  ]
}
