{
  "description": "Watch movies and dramas together with the group",
  "icon": {
    "image": "brand/icon.png",
    "emoji": "\ud83c\udfac"
  },
  "secrets": [],
  "visibility": {
    "build": "public",
    "view": "public"
  },
  "tests": [
    {
      "id": "series.browse",
      "name": "Series browse grid renders",
      "path": "/",
      "expectSelector": "[data-testid=series-grid]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "series.browse-shelves",
      "name": "Browse shows the featured hero and drama shelves",
      "path": "/",
      "expectSelector": "[data-testid=featured-hero] [data-testid=featured-item]",
      "expectText": "Chinese short dramas",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Country and format filters combine",
      "path": "/?country=kr&format=long",
      "expectSelector": "[data-testid=series-grid] [data-testid=series-tile][data-format=long]",
      "expectText": "Paper Crane Library"
    },
    {
      "name": "Search finds a series by its original title",
      "path": "/?q=%E6%B1%9F%E8%BE%B9",
      "expectSelector": "[data-testid=series-grid] [data-testid=series-tile]",
      "expectText": "Tea House by the River"
    },
    {
      "id": "series.no-results",
      "name": "No matches offers Clear filters",
      "path": "/?q=no-such-series-title",
      "expectSelector": "[data-testid=no-results] [data-testid=clear-filters]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Cards carry a bookmark and the header counts My List",
      "path": "/",
      "expectSelector": "[data-testid=series-tile] ~ [data-testid=bookmark-button][aria-pressed]",
      "expectText": "My List ("
    },
    {
      "id": "series.detail",
      "name": "Series detail lists episodes",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-state=locked]",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "series.detail-page",
      "name": "Series detail page shows Watch now and related series",
      "path": "/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=related-series] [data-testid=series-tile]",
      "expectText": "Watch now",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "id": "onboarding.genres",
      "name": "Genre onboarding offers genres to pick",
      "path": "/#/onboarding",
      "expectSelector": "[data-testid=genre-picker] button[aria-pressed]",
      "expectText": "What do you like to watch?",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "Series detail offers follow and unlock",
      "path": "/#/series/bakery-on-maple-street",
      "expectSelector": "[data-testid=episode-list] [data-testid=unlock-button]"
    },
    {
      "id": "mylist.following",
      "name": "My List opens on the Following tab",
      "path": "/my-list",
      "expectSelector": "[data-testid=my-list-tab-following][aria-current=page]",
      "expectText": "My List",
      "visual": true,
      "impact": [
        "public/**",
        "app/**",
        "lib/**"
      ]
    },
    {
      "name": "My List watch history tab",
      "path": "/my-list/history",
      "expectSelector": "[data-testid=my-list-tab-history][aria-current=page]"
    },
    {
      "name": "Browse links to My List",
      "path": "/",
      "expectSelector": "[data-testid=my-list-link]"
    }
  ],
  "private_tables": [
    "profiles",
    "watch_history",
    "coin_transactions",
    "unlocked_episodes"
  ]
}
